{
  "name": "rvault-extension",
  "displayName": "RVault",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package:firefox": "plasmo package --target=firefox-mv3",
    "test": "bun test"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  },
  "manifest": {
    "overrides": {
      "chrome": {
        "key": ""
      }
    },
    "permissions": [
      "nativeMessaging",
      "activeTab",
      "scripting",
      "clipboardWrite",
      "downloads"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "action": {
      "default_title": "RVault",
      "default_popup": "./popup.html"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "rvault@ata-sesli.github.io",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  }
}
