{
  "name": "rvault-extension",
  "displayName": "RVault",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "test": "bun test"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  },
  "manifest": {
    "key": "",
    "permissions": [
      "nativeMessaging",
      "activeTab",
      "scripting",
      "clipboardWrite",
      "downloads"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "action": {
      "default_title": "RVault",
      "default_popup": "./popup.html"
    }
  }
}
